# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mconnect?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Pesapal v3 ───────────────────────────────────────────────────────────────
# PESAPAL_ENV: "sandbox" → cybqa.pesapal.com  |  "live" → pay.pesapal.com
PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# URL Pesapal POSTs IPN notifications to. Must be publicly reachable.
# In development use ngrok: ngrok http 3000  →  paste the https URL here.
# Defaults to: ${NEXTAUTH_URL}/api/tiers/callback
PESAPAL_IPN_URL="https://yourdomain.com/api/tiers/callback"

# After first boot, copy the logged "Registered new IPN ID: <id>" value here
# to avoid re-registering on every server restart.
PESAPAL_IPN_ID=""

# ─── Cloudinary (profile photos) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@mconnect.co.ke"
